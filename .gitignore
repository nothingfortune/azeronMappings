node_modules/
build/
coverage/
*.tsbuildinfo

# Regenerate with `npm run azeron -- editor`; it embeds the whole payload, so committing
# it would churn a 250 KB blob on every data change. dist/*.json IS committed.
dist/editor.html

# Diagnostic artifacts, regenerated with `azeron probe`. The profiles in dist/ are the
# things worth having in history; these are tools.
dist/probe/

# Regenerated by `azeron editor` alongside editor.html.
dist/editor-data.json

# Playwright
test-results/
playwright-report/

# Claude Code's own working files, including the worktrees its agents work in. They sit
# inside the repo, so anything that walks the tree -- ESLint, Prettier -- has to skip them
# too, or it lints another checkout's half-finished files as if they were this one's.
.claude/
