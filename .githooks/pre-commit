#!/bin/sh
# Quick gate: the checks fast enough to run on every commit.
#
# It rebuilds and runs the library tests, which between them prove the golden export
# still round-trips, the baseline and both genre defaults still lint clean, the akimbo
# pair still covers every action, and dist/ matches the YAML. The full gate
# (typecheck + lint + format + DOM tests) runs on push.
set -e
cd "$(git rev-parse --show-toplevel)"

npm run --silent build
npm run --silent test:quick
