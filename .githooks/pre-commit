#!/bin/sh
# Quick gate: every unit test, on every commit.
#
# That proves the golden export still round-trips, the baseline and both genre defaults
# lint clean, the akimbo pair covers every action, dist/ and the game's bindings match
# the YAML, and the editor still saves what it shows. It used to run the build first and
# only the library tests -- but no unit test reads build/ (vitest compiles src/ itself),
# and leaving the editor out meant the save path went unchecked until push. Same time,
# more coverage. The full gate (build, typecheck, lint, format, CLI) runs on push.
set -e
cd "$(git rev-parse --show-toplevel)"

npm run --silent test:quick
